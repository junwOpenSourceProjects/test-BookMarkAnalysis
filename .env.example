# 书签分析系统 Docker 环境配置
# 复制此文件为 .env 并根据需要修改配置

# ==================== MySQL配置 ====================
MYSQL_ROOT_PASSWORD=root123456
MYSQL_DATABASE=bookmarks
MYSQL_USER=bookmarks
MYSQL_PASSWORD=bookmarks123
MYSQL_PORT=3306

# ==================== 应用配置 ====================
APP_PORT=8080

# ==================== AI 配置（DeepSeek V4） ====================
# 从 https://platform.deepseek.com 获取 API Key
BOOKMARK_AI_API_KEY=sk-your-deepseek-api-key
# 模型: deepseek-v4-flash(快速) 或 deepseek-v4-pro(强力)
BOOKMARK_AI_MODEL_NAME=deepseek-v4-flash
# API 地址（默认 DeepSeek 官方，也支持任意 OpenAI 兼容接口）
# BOOKMARK_AI_API_BASE_URL=https://api.deepseek.com/v1

# ==================== Redis配置（可选） ====================
REDIS_PORT=6379
